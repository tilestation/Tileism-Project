{
  "manifest_version": 3,
  "name": "Tile Station - Verona Sync",
  "version": "6.1.0",
  "description": "Sync product data from Verona Group - Light sync for stock & prices, Full sync for all details. v6.1: built-in self-check + diagnostics report.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.tilestation.co.uk/*",
    "https://*.railway.app/*",
    "https://*.emergentagent.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}